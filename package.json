{
  "name": "flashcards-english-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx --tsconfig tsconfig.server.json server/main.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --tsconfig tsconfig.server.json server/main.ts",
    "serve": "npm run build && npm start",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  }
}
